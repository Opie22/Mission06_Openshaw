@model Mission06_Openshaw.Models.Movie

@{
 ViewData["Title"] = "Edit Movie";
}

<h1>Edit Movie</h1>

<form method="post" asp-controller="Home" asp-action="Edit">
 <div asp-validation-summary="ModelOnly" class="text-danger"></div>

 <input type="hidden" asp-for="MovieId" />

    <div>
        <label asp-for="CategoryId">Category:</label>
        <select asp-for="CategoryId" asp-items="@(new SelectList(ViewBag.Categories, "CategoryId", "CategoryName"))">
            <option value="">Select a Category</option>
        </select>
        <span asp-validation-for="CategoryId" class="text-danger"></span>
    </div>

 <div>
     <label asp-for="Title">Title:</label>
     <input asp-for="Title" />
     <span asp-validation-for="Title" class="text-danger"></span>
 </div>

 <div>
     <label asp-for="Year">Year:</label>
     <input asp-for="Year" />
     <span asp-validation-for="Year" class="text-danger"></span>
 </div>

 <div>
     <label asp-for="Director">Director:</label>
     <input asp-for="Director" />
     <span asp-validation-for="Director" class="text-danger"></span>
 </div>

 <div>
     <label asp-for="Rating">Rating:</label>
     <select asp-for="Rating">
         <option value="G">G</option>
         <option value="PG">PG</option>
         <option value="PG-13">PG-13</option>
         <option value="R">R</option>
     </select>
     <span asp-validation-for="Rating" class="text-danger"></span>
 </div>

 <div>
     <label asp-for="Edited">Edited?</label>
     <input asp-for="Edited" type="checkbox" />
     <span asp-validation-for="Edited" class="text-danger"></span>
 </div>

 <div>
     <label asp-for="LentTo">Lent To:</label>
     <input asp-for="LentTo" />
 </div>

 <div>
     <label asp-for="Notes">Notes:</label>
     <input asp-for="Notes" maxlength="25" />
     <span asp-validation-for="Notes" class="text-danger"></span>
 </div>
 <div>
     <label asp-for="CopiedToPlex">Copied to Plex?</label>
     <input asp-for="CopiedToPlex" type="checkbox" />
     <span asp-validation-for="CopiedToPlex" class="text-danger"></span>
 </div>

 <button type="submit">Save Changes</button>
 <a asp-controller="Home" asp-action="MovieList">Cancel</a>
</form>