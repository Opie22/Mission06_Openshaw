@model IEnumerable<Mission06_Openshaw.Models.Movie>


@{
    ViewData["Title"] = "Movie List"; // Best Practice: Set ViewData["Title"]
}

<!DOCTYPE html>

<h1>Movie List</h1>
@* delete confirmation *@
    @if (TempData["Message"] != null)
    {
        <div class="alert alert-success">
            @TempData["Message"]
        </div>
    }
    
<table class="table table-bordered table-striped">
    <thead>
    <tr>
        <th>Category</th> @* Changed Order *@
        <th>Title</th>
        <th>Year</th>
        <th>Director</th>
        <th>Rating</th>
        <th>Edited</th>
        <th>Lent To</th>
        <th>Notes</th>
        <th>Copied to Plex</th>
        <th>Actions</th>
    </tr>
    </thead>
    <tbody>
    @foreach (var movie in Model)
    {
        <tr>
            <td>@movie.Category?.CategoryName</td> @* Correct navigation property access *@
            <td>@movie.Title</td>
            <td>@movie.Year</td>
            <td>@movie.Director</td>
            <td>@movie.Rating</td>
            <td>@(movie.Edited ? "Yes" : "No")</td>
            <td>@movie.LentTo</td>
            <td>@movie.Notes</td>
            <td>@(movie.CopiedToPlex ? "Yes" : "No")</td> @* Correct boolean display *@
            <td>
                <a asp-controller="Home" asp-action="Edit" asp-route-id="@movie.MovieId">Edit</a> |
                <a asp-controller="Home" asp-action="Delete" asp-route-id="@movie.MovieId">Delete</a>
            </td>
        </tr>
    }
    </tbody>
</table>